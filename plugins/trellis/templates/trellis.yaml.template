project:
  name: "{{PROJECT_NAME}}"
  description: "{{PROJECT_DESCRIPTION}}"

specialists:
  # Uncomment and set to delegate implementation to domain-specific agents:
  # bash: bark:bash-developer
  # java: graft:jenkins-developer

testers:
  # Uncomment to delegate test writing to domain-specific agents (requires tdd.enabled: true):
  # bash: bark:bash-developer
  # java: graft:jenkins-tester

models:
  worker: sonnet  # default for all workers (accepts: sonnet, opus, haiku, or any model ID)
  # Per-role overrides (optional) — keys match worker roles: PLAN, IMPLEMENT, REVIEW, FIX
  # planner: opus
  # implementer: sonnet
  # reviewer: sonnet
  # fixer: sonnet

  # Adaptive tier routing — selects model by task complexity.
  # Overrides per-role config when the orchestrator detects a tier match.
  # simple:   1-5 files, clear fixes (default: haiku — fast and cheap)
  # standard: 6+ files, bounded scope (default: sonnet — balanced)
  # complex:  cross-cutting, redesign, security/arch review (default: opus — thorough)
  # tiers:
  #   simple: haiku
  #   standard: sonnet
  #   complex: opus

tdd:
  # Test-Driven Development mode.
  # When enabled, trellis spawns a TEST WRITER worker before the implementer.
  # Tests are written first (and committed as a baseline), then the implementer makes them pass.
  # The review worker verifies the implementer did not modify test assertions.
  enabled: {{TDD_ENABLED}}

  # Pause for user approval after tests are written, before implementation starts.
  # Set to false to let trellis run test-write + implement back-to-back without a gate.
  approve_tests: {{TDD_APPROVE_TESTS}}

  # Skip TDD for this entire plan when ALL tasks match one of these keywords (case-insensitive substring match).
  # Use for plans that are purely documentation, configuration, or migration work with no testable behavior.
  # exclude: [docs, config, migration]

stewardship:
  # Documents that define "good" for this project.
  # Paths are relative to project root. Created during bootstrap.
  vision: VISION.md
  decisions: DECISIONS.md
  architecture: ARCHITECTURE.md  # created during bootstrap (analyzed for existing codebases, empty for new)

  # Automated audit configuration.
  # frequency: commits between checks (0 = on-demand only)
  # mode: nudge (remind user) or auto (run automatically)
  audits:
    consistency:
      frequency: 8
      mode: nudge
    security:
      frequency: 15
      mode: auto
    architecture:
      frequency: 20
      mode: nudge
    vision:
      frequency: 0
    dx:
      frequency: 0
    debt:
      frequency: 0
